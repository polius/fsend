# {$FSEND_DOMAIN} comes from docker-compose.yml; Caddy auto-issues a Let's Encrypt cert.

{$FSEND_DOMAIN} {
    reverse_proxy fsend:8080 {
        # Must exceed the 25s signaling long-poll window.
        transport http {
            read_timeout 30s
            write_timeout 30s
        }
    }

    log {
        output stdout
        level WARN  # flip to INFO/DEBUG while debugging
    }
}
