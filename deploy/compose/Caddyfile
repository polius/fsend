# Caddy config for the reference fsend-server self-host stack.
# {$FSEND_DOMAIN} is injected by docker-compose.yml; Caddy auto-provisions
# a Let's Encrypt cert for it.

{$FSEND_DOMAIN} {
    reverse_proxy fsend-server:8080 {
        # Forward the real client IP so fsend-server's rate-limiter and
        # STUN reflection see peers, not Caddy.
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Signaling long-polls (POST /v1/session/{code}/wait) can hold a
        # connection open up to 25s. Keep the idle window above that so
        # they don't get cut. Signaling only — file transfer is QUIC over
        # UDP and doesn't traverse Caddy.
        transport http {
            read_timeout 30s
            write_timeout 30s
        }
    }

    # WARN-only logs by default. Flip to INFO/DEBUG while debugging.
    log {
        output stdout
        level WARN
    }

    # The signaling API serves JSON, never HTML — these browser-targeted
    # headers are unnecessary but free.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
}
